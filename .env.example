# Copy to .env (git-ignored) and fill in. Docker Compose reads .env automatically.

# JWT signing secret shared by gateway + user-ms. Use a DIFFERENT value in every environment
# (your laptop, AWS, ...) so a token issued in one environment is rejected everywhere else.
# Generate:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Browser origins allowed by the Gateway (CORS). Comma-separated, no spaces.
# Local Vite dev server + deployed frontend:
FRONTEND_URL=http://localhost:5173,https://hms-theta-ten.vercel.app

# Optional
# SWAGGER_ENABLED=false
# HMS_BUSINESS_TIMEZONE=Asia/Kolkata
