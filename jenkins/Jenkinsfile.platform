/*
 * JOB 1 of 2 — "hms-platform"
 *
 * Creates the cluster, installs the platform tools, builds and deploys HMS, seeds
 * the data, and proves every endpoint answers. Run it once; re-run it after any
 * code change (it is idempotent — Terraform and kubectl both converge).
 *
 * There is deliberately NO load test in here. A load test is a performance gate,
 * not a build gate: putting it in the build makes every commit slow and flaky.
 * Traffic is job 2.
 */

pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
  }

  /*
   * Continuous integration without opening a firewall.
   *
   * The usual way is a GitHub webhook: GitHub calls Jenkins the moment you push.
   * That needs Jenkins reachable FROM the internet — which would mean opening
   * port 8080 to the world (or tunnelling it with something like ngrok). This
   * Jenkins is deliberately locked to one IP, so instead it polls: every two
   * minutes it asks GitHub "any new commit?" and builds if there is one.
   *
   * Trade-off, and the honest answer if asked: a webhook reacts instantly and
   * costs nothing; polling costs one tiny API call every two minutes and reacts
   * up to two minutes late. For a private controller, polling is the normal
   * choice. Nothing is tunnelled and nothing extra is exposed.
   */
  triggers {
    pollSCM('H/2 * * * *')
  }

  parameters {
    booleanParam(name: 'CREATE_INFRA', defaultValue: true,
                 description: 'Run Terraform. Untick to redeploy the app onto a cluster that already exists (much faster).')
    booleanParam(name: 'INSTALL_PLATFORM', defaultValue: true,
                 description: 'Install/upgrade ingress-nginx, Prometheus, Grafana, KEDA and k6-operator.')
    string(name: 'OPERATOR_CIDR', defaultValue: '0.0.0.0/0',
           description: 'Your public IP as x.x.x.x/32 — restricts who can open Grafana. Find it with: curl ifconfig.me')
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
    CLUSTER_NAME       = 'hms-eks'
    PROJECT            = 'hms'
    IMAGE_TAG          = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : env.BUILD_NUMBER}"
    // Passed into the shell as a plain variable so no Groovy/shell quoting tricks are needed.
    OPERATOR_CIDR      = "${params.OPERATOR_CIDR}"
  }

  stages {

    /* ---------------------------------------------------------------- 1 */
    stage('Infrastructure (Terraform)') {
      when { expression { params.CREATE_INFRA } }
      steps {
        dir('infra/eks') {
          sh '''
            set -e
            terraform init -input=false
            terraform apply -auto-approve -input=false \
              -var="region=${AWS_DEFAULT_REGION}" \
              -var="cluster_name=${CLUSTER_NAME}" \
              -var="project=${PROJECT}"
          '''
        }
      }
    }

    /* ---------------------------------------------------------------- 2 */
    stage('Connect to cluster') {
      steps {
        sh '''
          set -e
          aws eks update-kubeconfig --region "${AWS_DEFAULT_REGION}" --name "${CLUSTER_NAME}"
          kubectl get nodes -L role
        '''
      }
    }

    /* ---------------------------------------------------------------- 3 */
    stage('Platform tools (Helm)') {
      when { expression { params.INSTALL_PLATFORM } }
      steps {
        sh '''
          set -e
          helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
          helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
          helm repo add kedacore https://kedacore.github.io/charts
          helm repo add grafana https://grafana.github.io/helm-charts
          helm repo update

          # Grafana password: generated once, then reused on every later run so the
          # password you wrote down keeps working.
          kubectl get ns monitoring >/dev/null 2>&1 || kubectl create ns monitoring
          GRAFANA_PASSWORD=$(kubectl -n monitoring get secret kube-prometheus-stack-grafana \
              -o jsonpath='{.data.admin-password}' 2>/dev/null | base64 -d || true)
          if [ -z "$GRAFANA_PASSWORD" ]; then
            GRAFANA_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=' | head -c 16)
          fi
          echo "$GRAFANA_PASSWORD" > .grafana_pw

          # Monitoring first: the ingress controller wants to register a ServiceMonitor,
          # which only exists once the Prometheus operator has installed its CRDs.
          helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
            --namespace monitoring --create-namespace \
            -f monitoring/values-kube-prometheus.yaml \
            --set grafana.adminPassword="$GRAFANA_PASSWORD" \
            --set "grafana.service.loadBalancerSourceRanges[0]=${OPERATOR_CIDR}" \
            --wait --timeout 15m

          helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx \
            --namespace ingress-nginx --create-namespace \
            -f monitoring/values-ingress-nginx.yaml \
            --wait --timeout 10m

          helm upgrade --install keda kedacore/keda \
            --namespace keda --create-namespace --wait --timeout 10m

          # k6-operator runs the load tests later, from job 2.
          helm upgrade --install k6-operator grafana/k6-operator \
            --namespace k6 --create-namespace --wait --timeout 10m
        '''
      }
    }

    /* ---------------------------------------------------------------- 4 */
    stage('Build images') {
      steps {
        sh '''
          set -e
          ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
          export ECR_REGISTRY="${ACCOUNT}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
          echo "${ECR_REGISTRY}" > .ecr_registry

          aws ecr get-login-password --region "${AWS_DEFAULT_REGION}" \
            | docker login --username AWS --password-stdin "${ECR_REGISTRY}"

          build() {   # build() <ecr-repo-name> <build-context>
            docker build -t "${ECR_REGISTRY}/hms/$1:${IMAGE_TAG}" "$2"
            docker push  "${ECR_REGISTRY}/hms/$1:${IMAGE_TAG}"
          }

          build eureka-server   backend/Eureka-Server
          build gateway         backend/GatewayMS
          build user-ms         backend/UserMS
          build profile-ms      backend/ProfileMS
          build appointment-ms  backend/Appointment
          build pharmacy-ms     backend/PharmacyMS
          build notification-ms backend/NotificationMS
          build frontend        frontend/hms
        '''
      }
    }

    /* ---------------------------------------------------------------- 5 */
    stage('Deploy to Kubernetes') {
      steps {
        sh '''
          set -e
          export ECR_REGISTRY=$(cat .ecr_registry)

          kubectl apply -f k8s/00-namespace.yaml

          # Secrets never live in git. JWT_SECRET is generated once and kept in the
          # cluster; re-running the pipeline does not invalidate issued tokens.
          kubectl -n hms get secret hms-secrets >/dev/null 2>&1 || \
            kubectl -n hms create secret generic hms-secrets \
              --from-literal=JWT_SECRET="$(openssl rand -base64 64 | tr -d '\\n')" \
              --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24 | tr -d '/+=' | head -c 20)"

          # The database list comes from the same SQL file Docker Compose uses.
          kubectl -n hms create configmap postgres-init \
            --from-file=init-databases.sql=docker/postgres/init-databases.sql \
            --dry-run=client -o yaml | kubectl apply -f -

          # envsubst puts the image registry and tag into the manifests.
          for f in k8s/10-data.yaml k8s/20-services.yaml k8s/30-frontend-ingress.yaml; do
            envsubst '${ECR_REGISTRY} ${IMAGE_TAG}' < "$f" | kubectl apply -f -
          done

          kubectl apply -f k8s/41-monitoring.yaml
          kubectl apply -f k8s/40-autoscaling.yaml

          # The Grafana dashboard is provisioned, not clicked together. Grafana runs a
          # sidecar that watches for ConfigMaps carrying the label grafana_dashboard=1
          # and loads whatever JSON they contain — so the dashboard exists the first
          # time you log in, and a change to the JSON file in git redeploys it.
          kubectl -n monitoring create configmap hms-dashboard \
            --from-file=hms-dashboard.json=monitoring/dashboard-hms.json \
            --dry-run=client -o yaml \
            | kubectl label --local -f - grafana_dashboard=1 -o yaml \
            | kubectl apply -f -

          # Order matters on a cold cluster: the services will not pass readiness
          # until Postgres and Eureka are up.
          kubectl -n hms rollout status deploy/postgres        --timeout=5m
          kubectl -n hms rollout status deploy/kafka           --timeout=5m
          kubectl -n hms rollout status deploy/eureka-server   --timeout=5m
          for d in gateway user-ms profile-ms appointment-ms pharmacy-ms notification-ms frontend; do
            kubectl -n hms rollout status deploy/$d --timeout=6m
          done
        '''
      }
    }

    /* ---------------------------------------------------------------- 6 */
    stage('Wait for public address') {
      steps {
        sh '''
          set -e
          echo "Waiting for the load balancer to get a DNS name..."
          for i in $(seq 1 60); do
            HOST=$(kubectl -n ingress-nginx get svc ingress-nginx-controller \
                   -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
            [ -n "$HOST" ] && break
            sleep 10
          done
          [ -n "$HOST" ] || { echo "Load balancer never got an address"; exit 1; }
          echo "http://$HOST" > .public_url

          # An NLB answers before DNS has propagated everywhere; wait for a real reply.
          for i in $(seq 1 60); do
            code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://$HOST/healthz" || true)
            [ "$code" = "200" ] && break
            sleep 10
          done
          echo "Public URL: http://$HOST"
        '''
      }
    }

    /* ---------------------------------------------------------------- 7 */
    stage('Seed data') {
      steps {
        sh '''
          set -e
          BASE="$(cat .public_url)/api"
          echo "Seeding through the public gateway: $BASE"
          PATIENTS=200 DOCTORS=50 MEDICINES=20 HISTORY_VISITS=2 \
            BASE_URL="$BASE" node k6/seed/seed.js
        '''
      }
    }

    /* ---------------------------------------------------------------- 8 */
    stage('Verify every endpoint') {
      steps {
        sh '''
          set -e
          BASE="$(cat .public_url)"
          API="$BASE/api"
          fail=0

          check() {   # check <label> <url> <expected-code> [auth-header]
            code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 ${4:+-H "$4"} "$2")
            if [ "$code" = "$3" ]; then printf "  PASS  %-34s %s\\n" "$1" "$code"
            else printf "  FAIL  %-34s got %s want %s\\n" "$1" "$code" "$3"; fail=1; fi
          }

          TOKEN=$(curl -s -X POST "$API/users/login" -H 'Content-Type: application/json' \
                  -d '{"email":"bench.admin@hmsbench.local","password":"Bench@1234"}' | tr -d '"')
          AUTH="Authorization: Bearer $TOKEN"

          echo "Endpoint checks against $BASE"
          check "frontend page"           "$BASE/"                                200
          check "frontend health"         "$BASE/healthz"                         200
          check "gateway rejects no-auth" "$API/profile/patient/getAll"            401
          check "admin lists patients"    "$API/profile/patient/getAll"            200 "$AUTH"
          check "admin appointments"      "$API/appointment/all?page=0&size=5"     200 "$AUTH"
          check "doctor dropdowns"        "$API/profile/doctor/dropdowns"          200 "$AUTH"
          check "pharmacy medicines"      "$API/pharmacy/medicine/getAll"          200 "$AUTH"
          check "notifications"           "$API/notification/patient/1"            200 "$AUTH"

          [ "$fail" = "0" ] || { echo "Some endpoints failed - deployment is not healthy"; exit 1; }
        '''
      }
    }
  }

  post {
    success {
      sh '''
        echo "=================================================================="
        echo " HMS is live"
        echo "   Application : $(cat .public_url)"
        echo "   Grafana     : http://$(kubectl -n monitoring get svc kube-prometheus-stack-grafana \
                                 -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')"
        echo "   Grafana user: admin"
        echo "   Grafana pass: $(cat .grafana_pw 2>/dev/null || kubectl -n monitoring get secret \
                                 kube-prometheus-stack-grafana -o jsonpath='{.data.admin-password}' | base64 -d)"
        echo "=================================================================="
        kubectl -n hms get pods -o wide
      '''
      archiveArtifacts artifacts: '.public_url, k6/data/bench-meta.json', allowEmptyArchive: true
    }
    failure {
      sh 'kubectl -n hms get pods || true; kubectl -n hms describe pods | tail -60 || true'
    }
  }
}
