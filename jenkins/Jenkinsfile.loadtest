/*
 * JOB 2 of 2 — "hms-loadtest"
 *
 * This is the one you click during the presentation. It does not build or deploy
 * anything; it only fires traffic at the public URL and shows what the cluster
 * does about it.
 *
 * Pick RATE on the "Build with Parameters" screen:
 *   1000 -> 1 gateway pod stays                    (baseline)
 *   2500 -> about 3 gateway pods
 *   5000 -> about 5 gateway pods   <- the demo number
 *
 * Why those numbers: the gateway was measured at ~1540 req/s per CPU core, and
 * KEDA is set to 1200 req/s per pod (that same figure at a safe 70%). So the pod
 * count is RATE / 1200, rounded up — arithmetic, not a guess.
 */

pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }

  parameters {
    choice(name: 'RATE', choices: ['1000', '2500', '5000', '10000'],
           description: 'Total requests per second to generate.')
    string(name: 'DURATION', defaultValue: '3m',
           description: 'How long to hold that rate. 3m is right for a live demo.')
    string(name: 'PARALLELISM', defaultValue: '4',
           description: 'How many k6 pods split the work. 4 is enough up to ~5000 req/s.')
    booleanParam(name: 'WATCH_SCALING', defaultValue: true,
                 description: 'Print the pod count every 15s while the test runs (useful if Grafana is not on screen).')
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
    CLUSTER_NAME       = 'hms-eks'
    RUN_ID             = "${env.BUILD_NUMBER}"
    // Parameters copied into the environment so the shell blocks can stay plain.
    RATE        = "${params.RATE}"
    DURATION    = "${params.DURATION}"
    PARALLELISM = "${params.PARALLELISM}"
  }

  stages {

    stage('Connect and locate the public URL') {
      steps {
        sh '''
          set -e
          aws eks update-kubeconfig --region "${AWS_DEFAULT_REGION}" --name "${CLUSTER_NAME}"

          HOST=$(kubectl -n ingress-nginx get svc ingress-nginx-controller \
                 -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
          [ -n "$HOST" ] || { echo "No public address - run hms-platform first"; exit 1; }

          # The load test targets the SAME url a browser uses, through the ingress.
          # /api is where the frontend sends its calls, so this is the real user path.
          echo "http://$HOST/api" > .base_url
          echo "Target: $(cat .base_url)"

          curl -fsS --max-time 10 "http://$HOST/healthz" >/dev/null && echo "frontend is up"
        '''
      }
    }

    stage('Refresh tokens') {
      steps {
        sh '''
          set -e
          # JWTs live 5 hours. If the platform job ran this morning, the tokens in
          # k6/data are stale and every request would come back 401 - which would
          # look like a load problem on stage and is not one.
          BASE_URL="$(cat .base_url)" TOKENS_ONLY=1 node k6/seed/seed.js \
            || BASE_URL="$(cat .base_url)" node k6/seed/seed.js
        '''
      }
    }

    stage('Ship the scripts into the cluster') {
      steps {
        sh '''
          set -e
          # k6 pods cannot see the Jenkins workspace, so the scripts and the user
          # data travel as a ConfigMap. (ConfigMaps cap at ~1 MB; the 251-user seed
          # file is ~150 KB, so there is room. A much larger seed would need a volume.)
          kubectl -n hms create configmap k6-scripts \
            --from-file=k6/api-load.js \
            --from-file=k6/lib/ \
            --from-file=k6/data/bench-users.json \
            --from-file=k6/data/bench-meta.json \
            --dry-run=client -o yaml | kubectl apply -f -
        '''
      }
    }

    stage('Record the "before" picture') {
      steps {
        sh '''
          echo "--- before the load ---"
          kubectl -n hms get deploy gateway -o wide
          kubectl -n hms get scaledobject,hpa
        '''
      }
    }

    stage('Fire traffic') {
      steps {
        sh '''
          set -e
          export BASE_URL=$(cat .base_url)
          export PARALLELISM RATE DURATION RUN_ID
          # Each runner pod carries its share of the total rate.
          export RPS_PER_RUNNER=$(( RATE / PARALLELISM ))

          echo "Total ${RATE} req/s = ${PARALLELISM} pods x ${RPS_PER_RUNNER} req/s, for ${DURATION}"

          envsubst < k8s/loadtest/k6-testrun.yaml | kubectl apply -f -
        '''
      }
    }

    stage('Watch it scale') {
      steps {
        sh '''
          set -e
          echo "time      gateway-pods   ingress req/s"
          END=$(( $(date +%s) + 300 ))
          while [ $(date +%s) -lt $END ]; do
            PODS=$(kubectl -n hms get deploy gateway -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo 0)
            printf "%s        %-14s\\n" "$(date +%H:%M:%S)" "${PODS:-0}"
            # Stop as soon as the k6 pods have finished.
            RUNNING=$(kubectl -n hms get pods -l k6_cr=hms-load-${RUN_ID} \
                      --field-selector=status.phase=Running -o name 2>/dev/null | wc -l)
            [ "$RUNNING" = "0" ] && [ "$(date +%s)" -gt $(( END - 240 )) ] && break
            sleep 15
          done
        '''
      }
    }

    stage('Collect the results') {
      steps {
        sh '''
          set -e
          mkdir -p results
          kubectl -n hms logs -l k6_cr=hms-load-${RUN_ID} --tail=-1 --prefix=true > results/k6-${RUN_ID}.log 2>/dev/null || true
          kubectl -n hms get hpa,scaledobject -o wide > results/autoscaling-${RUN_ID}.txt 2>/dev/null || true
          kubectl -n hms get pods -o wide > results/pods-${RUN_ID}.txt

          echo "--- after the load ---"
          kubectl -n hms get deploy gateway -o wide
          tail -40 results/k6-${RUN_ID}.log || true
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'results/*', allowEmptyArchive: true
      // Leaving a finished TestRun behind would block the next run of this job.
      sh 'kubectl -n hms delete testrun hms-load-${RUN_ID} --ignore-not-found=true'
    }
    success {
      echo "Done. Pods scale back in after about 2 minutes of quiet (KEDA cooldownPeriod)."
    }
  }
}
