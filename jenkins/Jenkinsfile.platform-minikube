/*
 * JOB 1 of 2 — "hms-platform"   (minikube-on-EC2 edition)
 *
 * Everything from an empty cluster to a working, seeded, verified HMS:
 *   cluster up -> Prometheus/Grafana/KEDA -> 8 images -> deploy -> seed -> verify
 *
 * Run it once. Re-run it after any code change; it is idempotent (helm upgrade,
 * kubectl apply and docker build all converge rather than duplicate).
 *
 * There is deliberately NO load test in here. A load test is a performance gate,
 * not a build gate: inside the build it makes every commit slow and flaky.
 * Traffic is job 2.
 */

pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 50, unit: 'MINUTES')
  }

  /*
   * Continuous integration without opening a firewall: a GitHub webhook would
   * need Jenkins reachable from the internet, and this Jenkins is locked to one
   * IP. So it polls instead — one small API call every two minutes, no tunnel.
   */
  triggers {
    pollSCM('H/2 * * * *')
  }

  parameters {
    booleanParam(name: 'INSTALL_PLATFORM', defaultValue: true,
                 description: 'Install/upgrade ingress-nginx, Prometheus, Grafana and KEDA. Untick for a faster redeploy of just the app.')
  }

  environment {
    // The manifests prefix every image with this; locally built images never leave the box.
    ECR_REGISTRY     = 'hms-local'
    IMAGE_TAG        = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : env.BUILD_NUMBER}"
    // Requests per second one gateway pod carries, i.e. the KEDA threshold.
    // replicas = arriving req/s / this, capped at maxReplicaCount (6).
    // 100 makes the scaling visible within the few minutes a demo has:
    // 300 req/s -> 3 pods, 500 -> 5, 600 and above -> 6.
    KEDA_RPS_PER_POD = '100'
  }

  stages {

    /* ---------------------------------------------------------------- 1 */
    stage('Cluster up') {
      steps {
        sh '''
          set -e
          # systemd starts minikube at boot; this is the safety net if it was stopped.
          minikube status >/dev/null 2>&1 || minikube start --driver=docker --cpus=3 --memory=10240 --addons=metrics-server
          NODE=$(kubectl get nodes -o jsonpath='{.items[0].metadata.name}')
          # Every Deployment asks for nodeSelector role=app; on one node we label it.
          kubectl label node "$NODE" role=app --overwrite
          kubectl get nodes -o wide
          echo "cluster IP: $(minikube ip)"
        '''
      }
    }

    /* ---------------------------------------------------------------- 2 */
    stage('Platform tools (Helm)') {
      when { expression { params.INSTALL_PLATFORM } }
      steps {
        sh '''
          set -e
          helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx >/dev/null 2>&1 || true
          helm repo add prometheus-community https://prometheus-community.github.io/helm-charts >/dev/null 2>&1 || true
          helm repo add kedacore https://kedacore.github.io/charts >/dev/null 2>&1 || true
          helm repo update >/dev/null

          # Prometheus first: it installs the CRDs that the ingress controller's
          # ServiceMonitor needs in order to register itself.
          helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
            --namespace monitoring --create-namespace \
            -f monitoring/values-kube-prometheus.minikube.yaml \
            --wait --timeout 15m

          helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx \
            --namespace ingress-nginx --create-namespace \
            -f monitoring/values-ingress-nginx.minikube.yaml \
            --wait --timeout 10m

          helm upgrade --install keda kedacore/keda \
            --namespace keda --create-namespace --wait --timeout 10m
        '''
      }
    }

    /* ---------------------------------------------------------------- 3 */
    /*
     * This always runs, and there is deliberately no "skip the build" switch.
     * IMAGE_TAG is the git commit, so the manifests always ask for
     * hms/<svc>:<this commit>. Skipping the build leaves that tag nonexistent,
     * Kubernetes falls back to pulling it from Docker Hub, and every pod lands
     * in ImagePullBackOff - which is what happened on build #6.
     *
     * The cost of removing the switch is near zero: Docker caches every layer,
     * so when nothing has changed this stage finishes in a few seconds.
     */
    stage('Build images') {
      steps {
        sh '''
          set -e
          # Build straight into minikube's own Docker daemon, so no registry, no
          # push, no pull. The images are simply already there when Kubernetes
          # looks for them.
          eval $(minikube docker-env)

          build() {  # build <name> <context>
            echo "--- building $1"
            docker build -q -t "${ECR_REGISTRY}/hms/$1:${IMAGE_TAG}" "$2"
          }
          build eureka-server   backend/Eureka-Server
          build gateway         backend/GatewayMS
          build user-ms         backend/UserMS
          build profile-ms      backend/ProfileMS
          build appointment-ms  backend/Appointment
          build pharmacy-ms     backend/PharmacyMS
          build notification-ms backend/NotificationMS
          build frontend        frontend/hms

          docker images --filter "reference=${ECR_REGISTRY}/hms/*" --format "  {{.Repository}}:{{.Tag}}  {{.Size}}"
        '''
      }
    }

    /* ---------------------------------------------------------------- 4 */
    stage('Deploy to Kubernetes') {
      steps {
        sh '''
          set -e
          kubectl apply -f k8s/00-namespace.yaml

          # Secrets never live in git, and they are generated once: re-running the
          # pipeline does not invalidate tokens that were already issued.
          kubectl -n hms get secret hms-secrets >/dev/null 2>&1 || \
            kubectl -n hms create secret generic hms-secrets \
              --from-literal=JWT_SECRET="$(openssl rand -base64 64 | tr -d '\\n')" \
              --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24 | tr -d '/+=' | head -c 20)"

          # The database list comes from the same SQL file Docker Compose uses.
          kubectl -n hms create configmap postgres-init \
            --from-file=init-databases.sql=docker/postgres/init-databases.sql \
            --dry-run=client -o yaml | kubectl apply -f -

          for f in k8s/10-data.yaml k8s/20-services.yaml k8s/30-frontend-ingress.yaml; do
            envsubst '${ECR_REGISTRY} ${IMAGE_TAG}' < "$f" | kubectl apply -f -
          done
          kubectl apply -f k8s/41-monitoring.yaml
          envsubst '${KEDA_RPS_PER_POD}' < k8s/40-autoscaling.yaml | kubectl apply -f -

          # The Grafana dashboard is provisioned, not clicked together: Grafana's
          # sidecar loads any ConfigMap labelled grafana_dashboard=1.
          kubectl -n monitoring create configmap hms-dashboard \
            --from-file=hms-dashboard.json=monitoring/dashboard-hms.json \
            --dry-run=client -o yaml \
            | kubectl label --local -f - grafana_dashboard=1 -o yaml \
            | kubectl apply -f -

          # Order matters on a cold cluster: services cannot pass readiness until
          # Postgres and Eureka answer.
          kubectl -n hms rollout status deploy/postgres      --timeout=6m
          kubectl -n hms rollout status deploy/kafka         --timeout=6m
          kubectl -n hms rollout status deploy/eureka-server --timeout=6m
          for d in gateway user-ms profile-ms appointment-ms pharmacy-ms notification-ms frontend; do
            kubectl -n hms rollout status deploy/$d --timeout=8m
          done
          kubectl -n hms get pods -o wide
        '''
      }
    }

    /* ---------------------------------------------------------------- 5 */
    stage('Seed data') {
      steps {
        sh '''
          set -e
          BASE="http://$(minikube ip):30080"
          echo "$BASE" > .base_url

          for i in $(seq 1 30); do
            [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$BASE/healthz" || true)" = "200" ] && break
            sleep 5
          done

          # A Ready pod is not yet a ROUTABLE one. Until the gateway has fetched
          # the registry from Eureka, lb://UserMS has no instance behind it and
          # every call returns 503. Any other status - even 400 or 401 - proves
          # the request reached the service, which is all we are waiting for.
          echo "waiting for the gateway to resolve UserMS through Eureka"
          for i in $(seq 1 60); do
            code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
                     -X POST "$BASE/api/users/login" \
                     -H 'Content-Type: application/json' \
                     -d '{"email":"routing.probe@invalid","password":"x"}' || true)
            case "$code" in
              000|502|503|504) sleep 5 ;;
              *) echo "gateway is routing after $((i * 5))s (HTTP $code)"; break ;;
            esac
          done

          echo "seeding through the public API at $BASE/api"
          # These are read by k6/seed/seed.js and every one of them is prefixed
          # BENCH_. Without the prefix they are silently ignored and the script
          # falls back to its defaults (200 patients, 50 doctors, 30 visits each),
          # which is what build #4 actually seeded.
          BENCH_PATIENTS=150 BENCH_DOCTORS=30 BENCH_MEDICINES=20 BENCH_HISTORY_VISITS=2 \
            BASE_URL="$BASE/api" node k6/seed/seed.js
        '''
      }
    }

    /* ---------------------------------------------------------------- 6 */
    stage('Verify every endpoint') {
      steps {
        sh '''
          set -e
          BASE="$(cat .base_url)"; API="$BASE/api"; fail=0

          check() {  # check <label> <url> <expected> [auth header]
            code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 ${4:+-H "$4"} "$2")
            if [ "$code" = "$3" ]; then printf "  PASS  %-34s %s\\n" "$1" "$code"
            else printf "  FAIL  %-34s got %s want %s\\n" "$1" "$code" "$3"; fail=1; fi
          }

          TOKEN=$(curl -s -X POST "$API/users/login" -H 'Content-Type: application/json' \
                  -d '{"email":"bench.admin@hmsbench.local","password":"Bench@1234"}' | tr -d '"')
          AUTH="Authorization: Bearer $TOKEN"

          echo "Endpoint checks against $BASE"
          check "frontend page"           "$BASE/"                               200
          check "frontend health"         "$BASE/healthz"                        200
          check "gateway rejects no-auth" "$API/profile/patient/getAll"          401
          check "admin lists patients"    "$API/profile/patient/getAll"          200 "$AUTH"
          check "admin appointments"      "$API/appointment/all?page=0&size=5"   200 "$AUTH"
          check "doctor dropdowns"        "$API/profile/doctor/dropdowns"        200 "$AUTH"
          check "pharmacy medicines"      "$API/pharmacy/medicine/getAll"        200 "$AUTH"
          check "notifications"           "$API/notification/patient/1"          200 "$AUTH"

          [ "$fail" = "0" ] || { echo "Deployment is not healthy"; exit 1; }
        '''
      }
    }
  }

  post {
    success {
      sh '''
        PUB=$(curl -s --max-time 5 http://169.254.169.254/latest/meta-data/public-ipv4 \
              -H "X-aws-ec2-metadata-token: $(curl -s -X PUT http://169.254.169.254/latest/api/token \
              -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')" || echo "<this-machine>")
        echo "=================================================================="
        echo " HMS is live"
        echo "   Application : http://$PUB:30080"
        echo "   Grafana     : http://$PUB:30030   (admin / admin)"
        echo "   Login as    : bench.admin@hmsbench.local / Bench@1234"
        echo
        echo " Next: run the job 'hms-loadtest' with RATE=600 and watch Grafana."
        echo "=================================================================="
        kubectl -n hms get deploy
      '''
    }
    failure {
      sh 'kubectl -n hms get pods || true; kubectl -n hms describe pods | tail -60 || true'
    }
  }
}
