/*
 * JOB 3 of 3 — "hms-destroy"
 *
 * The stop button. Deletes the EKS cluster, its nodes and its load balancers, so
 * the bill stops. Jenkins itself survives, so you can rebuild everything later
 * with one click on 'hms-platform'.
 *
 * Why it is a job and not a command you type: the control plane bills $0.10 an
 * hour from the moment the cluster exists, whether or not anything runs on it.
 * Teardown should be as easy as creation, or it does not happen.
 */

pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    timeout(time: 40, unit: 'MINUTES')
  }

  parameters {
    booleanParam(name: 'I_AM_SURE', defaultValue: false,
                 description: 'Tick this. Everything in the cluster is deleted, including the seeded data.')
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
    CLUSTER_NAME       = 'hms-eks'
  }

  stages {
    stage('Confirm') {
      steps {
        script {
          if (!params.I_AM_SURE) {
            error('Nothing was deleted. Tick I_AM_SURE if you really want the cluster gone.')
          }
        }
      }
    }

    stage('Delete load balancers first') {
      steps {
        sh '''
          set +e
          aws eks update-kubeconfig --region "${AWS_DEFAULT_REGION}" --name "${CLUSTER_NAME}"

          # The two LoadBalancer Services were created by Kubernetes, not Terraform,
          # so Terraform does not know about them. If they are left behind, deleting
          # the VPC fails (the load balancers still hold network interfaces in it),
          # and AWS keeps billing for them.
          kubectl -n ingress-nginx delete svc ingress-nginx-controller --ignore-not-found=true
          kubectl -n monitoring  delete svc kube-prometheus-stack-grafana --ignore-not-found=true
          echo "Waiting for AWS to release the load balancers..."
          sleep 60
        '''
      }
    }

    stage('Terraform destroy') {
      steps {
        dir('infra/eks') {
          sh '''
            set -e
            terraform init -input=false
            terraform destroy -auto-approve -input=false \
              -var="region=${AWS_DEFAULT_REGION}" \
              -var="cluster_name=${CLUSTER_NAME}"
          '''
        }
      }
    }

    stage('Check nothing is left running') {
      steps {
        sh '''
          echo "--- EKS clusters still in this region ---"
          aws eks list-clusters --region "${AWS_DEFAULT_REGION}"
          echo "--- EC2 instances still running ---"
          aws ec2 describe-instances --region "${AWS_DEFAULT_REGION}" \
            --filters "Name=instance-state-name,Values=running" \
            --query "Reservations[].Instances[].[InstanceId,InstanceType,Tags[?Key=='Name'].Value|[0]]" --output table
          echo "(the Jenkins box should be the only one left)"
          echo "--- load balancers still alive ---"
          aws elbv2 describe-load-balancers --region "${AWS_DEFAULT_REGION}" \
            --query "LoadBalancers[].[LoadBalancerName,State.Code]" --output table || true
        '''
      }
    }
  }

  post {
    success {
      echo 'Cluster deleted. The only thing still costing money is the Jenkins machine (~$0.08/hr). To remove that too, run "terraform destroy" in infra/bootstrap from your laptop.'
    }
  }
}
